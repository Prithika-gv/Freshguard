# SMTP configuration for automated emails (welcome emails, password reset codes)
# Without these set, emails are logged to the server console instead of sent —
# useful for local development, but you need real values for production.

# Example using Gmail SMTP (requires an App Password, not your regular password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-character-app-password
# SMTP_FROM="FreshGuard <you@gmail.com>"

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FreshGuard <no-reply@freshguard.io>"
